# Template - copy to .env (local dev) or .env.production (VM, shipped as .env).
# Never commit a file with real secrets (.env.* are gitignored).
# Only KEY=VALUE lines are read; keep any notes on their own '#' comment lines.

# --- App ---
SECRET_KEY=dev-secret-key-change-in-production
HOST=127.0.0.1
PORT=5000
# 'false' locks picks on the production schedule; 'true' = always editable.
ALLOW_UNRESTRICTED_EDITS=false
# Set FLASK_ENV=production ONLY after HTTPS is enabled (forces secure cookies,
# which are not sent over plain http and would break login).

# --- Database ---
DB_TYPE=sqlite
DB_PATH=fantasy_2025_26.db
# For hosted Postgres instead:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Scheduled jobs ---
# Bearer token the VM cron sends to /api/cron/tick. Generate a 64-char hex value
# with:  openssl rand -hex 32
CRON_SECRET=change-me
